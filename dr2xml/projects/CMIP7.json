    "institution_input": {
      "help": "Institution information from input",
      "fatal": true,
      "forbidden_values": [null, ""],
      "values": [
        {
          "type": "func",
          "origin": "vocabulary_server",
          "keys": ["get_term_in_collection"],
          "options": {
            "project_id": {
              "type": "value",
              "origin": "init",
              "keys": ["vocabulary_project"]
            },
            "collection_id": "institution_id",
            "term_id": {
              "type": "value",
              "origin": "init",
              "keys": ["institution_id"],
              "format": {
                "type": "func",
                "origin": "self",
                "keys": ["lower"]
              }
            }
          }
        }
      ]
