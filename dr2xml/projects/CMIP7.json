        {
          "type": "func",
          "origin": "vocabulary_server",
          "keys": ["get_all_terms_in_collection"],
          "options": {
            "project_id": {
              "type": "value",
              "origin": "init",
              "keys": ["vocabulary_project"]
            },
            "collection_id": "dataConventions"
