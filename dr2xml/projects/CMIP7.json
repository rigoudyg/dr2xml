            "source_id": {
              "type": "value",
              "origin": "internal",
              "keys": ["source_id"]
            }
          }
        },
        {
          "type": "value",
          "origin": "laboratory",
          "keys": ["source"]
        }
      ]
    },
    "source_input": {
      "help": "Source information from input",
      "fatal": true,
      "forbidden_values": [null, ""],
      "values": [
        {
          "type": "func",
          "origin": "vocabulary_server",
          "keys": ["get_term_in_collection"],
          "options": {
            "project_id": {
              "type": "value",
              "origin": "init",
              "keys": ["vocabulary_project"]
            },
            "collection_id": "source",
            "term_id": {
              "type": "value",
              "origin": "internal",
              "keys": ["source_id"],
              "format": {
                "type": "func",
                "origin": "self",
                "keys": ["lower"]
              }
            }
          }
        }
      ]
    },
    "title": {
      "help": "Title to be put on output files",
      "values": [
        {
          "type": "value",
          "origin": "simulation",
          "keys": "title"
        },
        {
          "type": "value",
          "origin": "laboratory",
          "keys": "title"
        },
        {
          "type": "func",
          "origin": "self",
          "keys": ["format"],
          "template": "{mip_era} {experiment_id} results from the {source_id} model.",
          "options": {
            "mip_era": {
              "type": "value",
              "origin": "common",
              "keys": ["mip_era", 0]
            },
            "experiment_id": {
              "type": "value",
              "origin": "internal",
              "keys": ["experiment_id"]
            },
            "source_id":{
              "type": "value",
              "origin": "internal",
              "keys": ["source_id"]
            }
          }
        }
      ]
    },
