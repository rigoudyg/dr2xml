        "conventions_version": {
          "help": "Conventions version used.",
          "values": [
            {
              "type": "value",
              "origin": "common",
              "keys": ["conventions_version"],
              "format": "CMIP6_conventions_version {}"
            }
          ]
        }
      }
    },
    "file_output": {
